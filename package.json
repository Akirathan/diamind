{
  "name": "diamind",
  "version": "0.1.0",
  "description": "Offline note taking app inspired by Workflowy, Obsidian and VSCode",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:e2e",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "4.0.0"
  }
}
